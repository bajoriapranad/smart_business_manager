<%- include('../partials/header') %>

<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
  <div>
    <div class="d-flex align-items-center gap-2 mb-1">
      <a href="/reports" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i> Hub</a>
      <h1 class="page-title mb-0">Operating Expenses &amp; Tax Audit Report</h1>
    </div>
    <p class="page-subtitle mb-0">Categorized operational overhead, recurring deductions, and tax audit trail</p>
  </div>
  <div class="d-flex align-items-center gap-2">
    <a href="/reports/expenses?format=csv&timeframe=<%= timeframe %>&startDate=<%= startDate %>&endDate=<%= endDate %>" class="btn btn-success">
      <i class="bi bi-file-earmark-excel me-1"></i> Download CSV
    </a>
  </div>
</div>

<!-- Timeframe Filter Toolbar -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
  <div class="card-body p-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
      <div class="btn-group btn-group-sm" role="group">
        <a href="/reports/expenses?timeframe=7days" class="btn <%= timeframe === '7days' ? 'btn-primary' : 'btn-outline-secondary' %>">Last 7 Days</a>
        <a href="/reports/expenses?timeframe=30days" class="btn <%= timeframe === '30days' ? 'btn-primary' : 'btn-outline-secondary' %>">Last 30 Days</a>
        <a href="/reports/expenses?timeframe=this_month" class="btn <%= timeframe === 'this_month' ? 'btn-primary' : 'btn-outline-secondary' %>">This Month</a>
        <a href="/reports/expenses?timeframe=last_month" class="btn <%= timeframe === 'last_month' ? 'btn-primary' : 'btn-outline-secondary' %>">Last Month</a>
        <a href="/reports/expenses?timeframe=this_year" class="btn <%= timeframe === 'this_year' ? 'btn-primary' : 'btn-outline-secondary' %>">This Year</a>
        <a href="/reports/expenses?timeframe=all" class="btn <%= timeframe === 'all' ? 'btn-primary' : 'btn-outline-secondary' %>">All Time</a>
      </div>

      <form method="GET" action="/reports/expenses" class="d-flex align-items-center gap-2">
        <input type="hidden" name="timeframe" value="custom">
        <input type="date" name="startDate" class="form-control form-control-sm" value="<%= startDate %>" required>
        <span class="text-muted small">to</span>
        <input type="date" name="endDate" class="form-control form-control-sm" value="<%= endDate %>" required>
        <button type="submit" class="btn btn-sm btn-primary">Filter</button>
      </form>
    </div>
  </div>
</div>

<!-- Summary Metrics -->
<div class="row g-3 mb-4">
  <div class="col-6 col-md-4">
    <div class="stat-card">
      <span class="stat-label">Total Operational Expenses</span>
      <div class="stat-value text-dark">
        <%= currency %><%= totals.totalExpense.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
      </div>
      <div class="stat-subtext text-muted"><%= expenses.length %> expense records</div>
    </div>
  </div>
  <div class="col-6 col-md-4">
    <div class="stat-card">
      <span class="stat-label">Paid / Settled</span>
      <div class="stat-value text-success">
        <%= currency %><%= totals.paidExpense.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
      </div>
      <div class="stat-subtext text-muted">Cleared overheads</div>
    </div>
  </div>
  <div class="col-12 col-md-4">
    <div class="stat-card border-start border-4 <%= totals.dueExpense > 0 ? 'border-danger' : 'border-success' %>">
      <span class="stat-label">Pending Liability / Unpaid</span>
      <div class="stat-value <%= totals.dueExpense > 0 ? 'text-danger' : 'text-success' %>">
        <%= currency %><%= totals.dueExpense.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
      </div>
      <div class="stat-subtext text-muted">Outstanding operational dues</div>
    </div>
  </div>
</div>

<!-- Expenses Table -->
<div class="card border-0 shadow-sm rounded-3">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="ps-4">Expense Title</th>
            <th>Category</th>
            <th class="text-end">Amount</th>
            <th>Date</th>
            <th>Due Date</th>
            <th class="text-center">Recurring</th>
            <th class="text-center">Status</th>
            <th class="pe-4">Notes</th>
          </tr>
        </thead>
        <tbody>
          <% if (expenses.length === 0) { %>
            <tr>
              <td colspan="8" class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                No expense entries found for this timeframe.
              </td>
            </tr>
          <% } else { %>
            <% expenses.forEach(e => { %>
              <tr>
                <td class="ps-4 fw-semibold text-dark">
                  <a href="/expenses" class="text-decoration-none text-dark">
                    <%= e.title %>
                  </a>
                </td>
                <td>
                  <span class="badge bg-secondary-subtle text-secondary"><%= e.category %></span>
                </td>
                <td class="text-end fw-bold text-dark">
                  <%= currency %><%= e.amount.toFixed(2) %>
                </td>
                <td class="text-muted small">
                  <%= new Date(e.date).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                </td>
                <td class="text-muted small">
                  <%= e.dueDate ? new Date(e.dueDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : '—' %>
                </td>
                <td class="text-center">
                  <% if (e.recurring) { %>
                    <span class="badge bg-info-subtle text-info"><i class="bi bi-arrow-repeat"></i> Recurring</span>
                  <% } else { %>
                    <span class="text-muted small">—</span>
                  <% } %>
                </td>
                <td class="text-center">
                  <% if (e.paymentStatus === 'Paid') { %>
                    <span class="badge bg-success-subtle text-success">Paid</span>
                  <% } else { %>
                    <span class="badge bg-danger-subtle text-danger">Unpaid</span>
                  <% } %>
                </td>
                <td class="text-muted small pe-4 text-truncate" style="max-width: 200px;">
                  <%= e.notes || '—' %>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
