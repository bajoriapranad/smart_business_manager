<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create Business Account | Smart Business Manager</title>
  
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <!-- Custom Business Theme CSS -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light">

  <div class="container py-5">
    <div class="row justify-content-center">
      <div class="col-12 col-sm-11 col-md-8 col-lg-6 col-xl-5">
        
        <!-- Brand Header -->
        <div class="text-center mb-4">
          <div class="d-inline-flex align-items-center justify-content-center bg-white border p-2 rounded mb-2 shadow-sm">
            <i class="bi bi-building-add text-primary fs-3"></i>
          </div>
          <h4 class="fw-bold text-dark mb-1">Create Business Account</h4>
          <p class="text-muted small">Set up your business in Smart Business Manager</p>
        </div>

        <!-- Alerts -->
        <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
          <div class="alert alert-danger alert-dismissible fade show flash-alert py-2 px-3 small" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-1"></i> <%= error_msg %>
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% } %>

        <!-- Registration Card -->
        <div class="card-business shadow-sm p-4">
          <form action="/auth/register" method="POST" autocomplete="on">
            
            <div class="row g-3">
              <!-- Full Name -->
              <div class="col-12 col-md-6">
                <label for="name" class="form-label fw-semibold small text-secondary">Owner / Manager Name <span class="text-danger">*</span></label>
                <div class="input-group">
                  <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-person"></i></span>
                  <input 
                    type="text" 
                    class="form-control border-start-0 ps-0" 
                    id="name" 
                    name="name" 
                    placeholder="e.g. Rahul Sharma" 
                    value="<%= typeof formData !== 'undefined' && formData.name ? formData.name : '' %>" 
                    required
                  >
                </div>
              </div>

              <!-- Phone -->
              <div class="col-12 col-md-6">
                <label for="phone" class="form-label fw-semibold small text-secondary">Phone Number <span class="text-danger">*</span></label>
                <div class="input-group">
                  <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-telephone"></i></span>
                  <input 
                    type="tel" 
                    class="form-control border-start-0 ps-0" 
                    id="phone" 
                    name="phone" 
                    placeholder="e.g. 9876543210" 
                    value="<%= typeof formData !== 'undefined' && formData.phone ? formData.phone : '' %>" 
                    required
                  >
                </div>
              </div>

              <!-- Business Name -->
              <div class="col-12">
                <label for="businessName" class="form-label fw-semibold small text-secondary">Business / Store Name <span class="text-danger">*</span></label>
                <div class="input-group">
                  <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-shop"></i></span>
                  <input 
                    type="text" 
                    class="form-control border-start-0 ps-0" 
                    id="businessName" 
                    name="businessName" 
                    placeholder="e.g. Sharma General Store" 
                    value="<%= typeof formData !== 'undefined' && formData.businessName ? formData.businessName : '' %>" 
                    required
                  >
                </div>
              </div>

              <!-- Email -->
              <div class="col-12">
                <label for="email" class="form-label fw-semibold small text-secondary">Email Address <span class="text-danger">*</span></label>
                <div class="input-group">
                  <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                  <input 
                    type="email" 
                    class="form-control border-start-0 ps-0" 
                    id="email" 
                    name="email" 
                    placeholder="name@business.com" 
                    value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>" 
                    required
                  >
                </div>
              </div>

              <!-- Password -->
              <div class="col-12 col-md-6">
                <label for="password" class="form-label fw-semibold small text-secondary">Password <span class="text-danger">*</span></label>
                <div class="input-group">
                  <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                  <input 
                    type="password" 
                    class="form-control border-start-0 ps-0" 
                    id="password" 
                    name="password" 
                    placeholder="Min 6 characters" 
                    minlength="6" 
                    required
                  >
                </div>
              </div>

              <!-- Confirm Password -->
              <div class="col-12 col-md-6">
                <label for="confirmPassword" class="form-label fw-semibold small text-secondary">Confirm Password <span class="text-danger">*</span></label>
                <div class="input-group">
                  <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-lock-fill"></i></span>
                  <input 
                    type="password" 
                    class="form-control border-start-0 ps-0" 
                    id="confirmPassword" 
                    name="confirmPassword" 
                    placeholder="Re-type password" 
                    minlength="6" 
                    required
                  >
                </div>
              </div>
            </div>

            <div class="d-grid gap-2 mt-4">
              <button type="submit" class="btn btn-primary py-2 fw-medium">
                <i class="bi bi-check-circle me-1"></i> Register Business
              </button>
            </div>

          </form>
        </div>

        <!-- Footer Links -->
        <div class="text-center mt-3 small text-muted">
          Already have an account? <a href="/auth/login" class="text-primary text-decoration-none fw-semibold">Sign In</a>
        </div>

      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
</body>
</html>
