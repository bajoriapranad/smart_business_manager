<%- include('../partials/header') %>

<div class="page-header">
  <div>
    <div class="d-flex align-items-center gap-2 mb-1">
      <h1 class="page-title"><%= product.name %></h1>
      <% if (product.currentStock === 0) { %>
        <span class="badge-status status-overdue">Out of Stock</span>
      <% } else if (product.currentStock <= product.minimumStock) { %>
        <span class="badge-status status-low">Low Stock</span>
      <% } else { %>
        <span class="badge-status status-normal">Healthy Stock</span>
      <% } %>
    </div>
    <p class="page-subtitle text-muted">SKU: <span class="fw-mono text-dark"><%= product.sku %></span> &bull; Category: <span class="text-dark"><%= product.category?.name || 'Unassigned' %></span></p>
  </div>
  <div class="d-flex align-items-center gap-2">
    <a href="/inventory" class="btn btn-sm btn-outline-secondary">
      <i class="bi bi-arrow-left me-1"></i> Products
    </a>
    <a href="/inventory/<%= product._id %>/edit" class="btn btn-sm btn-outline-primary">
      <i class="bi bi-pencil me-1"></i> Edit Product
    </a>
    <form action="/inventory/<%= product._id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this product?');">
      <button type="submit" class="btn btn-sm btn-outline-danger">
        <i class="bi bi-trash me-1"></i> Delete
      </button>
    </form>
  </div>
</div>

<!-- Product Financials & Stock Metric Cards -->
<div class="row g-3 mb-4">
  <div class="col-6 col-md-3">
    <div class="stat-card">
      <span class="stat-label">Current Stock</span>
      <div class="stat-value text-dark"><%= product.currentStock %> <span class="fs-6 text-muted"><%= product.unit %></span></div>
      <div class="stat-subtext text-muted">Min threshold: <%= product.minimumStock %> <%= product.unit %></div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="stat-card">
      <span class="stat-label">Stock Value (Cost)</span>
      <div class="stat-value text-primary"><%= currency %><%= calculations.stockValue.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div>
      <div class="stat-subtext text-muted"><%= currency %><%= product.purchasePrice.toFixed(2) %> per <%= product.unit %></div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="stat-card">
      <span class="stat-label">Potential Revenue</span>
      <div class="stat-value text-success"><%= currency %><%= calculations.potentialRevenue.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div>
      <div class="stat-subtext text-muted"><%= currency %><%= product.sellingPrice.toFixed(2) %> per <%= product.unit %></div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="stat-card">
      <span class="stat-label">Gross Margin</span>
      <div class="stat-value text-dark"><%= calculations.profitMargin %>%</div>
      <div class="stat-subtext text-muted"><%= currency %><%= (product.sellingPrice - product.purchasePrice).toFixed(2) %> markup / unit</div>
    </div>
  </div>
</div>

<div class="row g-3">
  <!-- Product Specifications Table -->
  <div class="col-12 col-lg-6">
    <div class="card-business">
      <div class="card-header fw-semibold">
        <i class="bi bi-info-circle me-1 text-primary"></i> Product Specifications
      </div>
      <div class="card-body p-0">
        <table class="table table-business mb-0">
          <tbody>
            <tr>
              <td class="text-muted" style="width: 40%;">Product Name</td>
              <td class="fw-semibold text-dark"><%= product.name %></td>
            </tr>
            <tr>
              <td class="text-muted">Item SKU</td>
              <td class="fw-mono text-dark"><%= product.sku %></td>
            </tr>
            <tr>
              <td class="text-muted">Category</td>
              <td><%= product.category?.name || 'Unassigned' %></td>
            </tr>
            <tr>
              <td class="text-muted">Brand</td>
              <td><%= product.brand || '—' %></td>
            </tr>
            <tr>
              <td class="text-muted">Description</td>
              <td><%= product.description || 'No description provided.' %></td>
            </tr>
            <tr>
              <td class="text-muted">Preferred Supplier</td>
              <td>
                <% if (product.supplier) { %>
                  <span class="fw-semibold text-dark"><%= product.supplier.name %></span>
                  <% if (product.supplier.company) { %>
                    <small class="text-muted">(<%= product.supplier.company %>)</small>
                  <% } %>
                  <% if (product.supplier.phone) { %>
                    <div class="small text-muted"><i class="bi bi-telephone me-1"></i><%= product.supplier.phone %></div>
                  <% } %>
                <% } else { %>
                  <span class="text-muted">Direct / None</span>
                <% } %>
              </td>
            </tr>
            <tr>
              <td class="text-muted">Stock Level Guidelines</td>
              <td>
                <span class="text-danger small fw-semibold">Min: <%= product.minimumStock %></span> &bull; 
                <span class="text-primary small fw-semibold">Target: <%= product.recommendedStock %></span> &bull; 
                <span class="text-secondary small fw-semibold">Max: <%= product.maximumStock %></span>
              </td>
            </tr>
            <tr>
              <td class="text-muted">Expiry Date</td>
              <td>
                <%= product.expiryDate ? new Date(product.expiryDate).toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' }) : 'N/A' %>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Stock Movement Audit Log -->
  <div class="col-12 col-lg-6">
    <div class="card-business">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span class="fw-semibold">
          <i class="bi bi-clock-history me-1 text-secondary"></i> Stock Movement Audit Trail
        </span>
        <span class="badge bg-light text-muted border">Last <%= movements ? movements.length : 0 %> movements</span>
      </div>
      <div class="card-body p-0">
        <% if (movements && movements.length > 0) { %>
          <div class="table-responsive">
            <table class="table table-business mb-0">
              <thead>
                <tr>
                  <th>Date</th>
                  <th>Type</th>
                  <th>Change</th>
                  <th>Balance</th>
                  <th>Notes</th>
                </tr>
              </thead>
              <tbody>
                <% movements.forEach(m => { %>
                  <tr>
                    <td class="text-muted" style="font-size: 11px;">
                      <%= new Date(m.date).toLocaleDateString('en-IN', { month: 'short', day: 'numeric' }) %>
                    </td>
                    <td>
                      <span class="badge bg-light text-dark border" style="font-size: 10px;"><%= m.type %></span>
                    </td>
                    <td>
                      <span class="fw-bold <%= m.quantity > 0 ? 'text-success' : 'text-danger' %>">
                        <%= m.quantity > 0 ? '+' + m.quantity : m.quantity %>
                      </span>
                    </td>
                    <td class="fw-semibold text-dark"><%= m.newStock %></td>
                    <td class="text-muted small">
                      <% if (m.type === 'PURCHASE' && m.referenceId) { %>
                        <a href="/purchases/<%= m.referenceId %>" class="text-primary text-decoration-none">
                          <i class="bi bi-link-45deg"></i> <%= m.notes || 'View Invoice' %>
                        </a>
                      <% } else { %>
                        <%= m.notes || '—' %>
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="p-4 text-center text-muted small">
            No stock movements recorded yet for this product.
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
