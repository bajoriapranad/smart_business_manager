<%- include('../partials/header') %>

<div class="page-header">
  <div>
    <h1 class="page-title">Operating Expenses &amp; Outflows</h1>
    <p class="page-subtitle">Track non-inventory business expenditures, recurring overheads, and upcoming vendor payables</p>
  </div>
  <div>
    <a href="/expenses/new" class="btn btn-sm btn-primary">
      <i class="bi bi-plus-circle me-1"></i> Record Expense
    </a>
  </div>
</div>

<!-- Expense KPI Summary Cards -->
<div class="row g-3 mb-4">
  <div class="col-6 col-md-3">
    <div class="stat-card">
      <span class="stat-label">Total Outflows</span>
      <div class="stat-value text-dark">
        <%= currency %><%= kpis.totalExpenses.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
      </div>
      <div class="stat-subtext text-muted"><%= kpis.totalCount %> recorded expenditures</div>
    </div>
  </div>

  <div class="col-6 col-md-3">
    <div class="stat-card">
      <span class="stat-label">Paid Expenses</span>
      <div class="stat-value text-success">
        <%= currency %><%= kpis.paidAmount.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
      </div>
      <div class="stat-subtext text-muted">Settled out of pocket</div>
    </div>
  </div>

  <div class="col-6 col-md-3">
    <div class="stat-card">
      <span class="stat-label">Pending &amp; Dues</span>
      <div class="stat-value <%= kpis.pendingAmount > 0 ? 'text-danger' : 'text-dark' %>">
        <%= currency %><%= kpis.pendingAmount.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
      </div>
      <div class="stat-subtext <%= kpis.overdueCount > 0 ? 'text-danger fw-semibold' : 'text-muted' %>">
        <% if (kpis.overdueCount > 0) { %>
          <i class="bi bi-exclamation-triangle-fill text-danger me-1"></i><%= kpis.overdueCount %> Overdue Bill<%= kpis.overdueCount > 1 ? 's' : '' %>
        <% } else { %>
          Upcoming payables
        <% } %>
      </div>
    </div>
  </div>

  <div class="col-6 col-md-3">
    <div class="stat-card">
      <span class="stat-label">Active Timeframe</span>
      <div class="stat-value text-primary text-capitalize" style="font-size: 1.25rem;">
        <%= filters.timeframe === 'all' ? 'All Time' : filters.timeframe %>
      </div>
      <div class="stat-subtext text-muted">Filter preset active</div>
    </div>
  </div>
</div>

<!-- Category Distribution Pills -->
<% if (categoryBreakdown && categoryBreakdown.length > 0) { %>
  <div class="card-business mb-3 p-3">
    <div class="d-flex align-items-center justify-content-between mb-2">
      <span class="text-xs text-uppercase fw-semibold text-muted tracking-wide">Category Spend Breakdown</span>
      <span class="text-xs text-muted"><%= categoryBreakdown.length %> Active Categories</span>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <% categoryBreakdown.forEach(cat => { %>
        <a 
          href="/expenses?category=<%= cat.name %>&timeframe=<%= filters.timeframe %>" 
          class="badge text-decoration-none py-2 px-3 d-flex align-items-center gap-2 border <%= filters.category === cat.name ? 'bg-primary text-white border-primary' : 'bg-light text-dark border-light-subtle' %>"
        >
          <span class="fw-semibold"><%= cat.name %></span>
          <span class="badge <%= filters.category === cat.name ? 'bg-white text-primary' : 'bg-secondary-subtle text-secondary' %>"><%= cat.percentage %>%</span>
          <span class="text-xs opacity-75"><%= currency %><%= cat.total.toLocaleString('en-IN') %></span>
        </a>
      <% }) %>
    </div>
  </div>
<% } %>

<!-- Search & Filter Controls -->
<div class="card-business mb-3 p-3">
  <form action="/expenses" method="GET" class="row g-2 align-items-center">
    <div class="col-12 col-md-3">
      <div class="input-group input-group-sm">
        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
        <input 
          type="text" 
          name="search" 
          class="form-control border-start-0 ps-0" 
          placeholder="Search title or notes..." 
          value="<%= filters.search %>"
        >
      </div>
    </div>

    <div class="col-6 col-md-2">
      <select name="category" class="form-select form-select-sm">
        <option value="">All Categories</option>
        <% categories.forEach(cat => { %>
          <option value="<%= cat %>" <%= filters.category === cat ? 'selected' : '' %>><%= cat %></option>
        <% }) %>
      </select>
    </div>

    <div class="col-6 col-md-2">
      <select name="paymentStatus" class="form-select form-select-sm">
        <option value="">All Statuses</option>
        <option value="Paid" <%= filters.paymentStatus === 'Paid' ? 'selected' : '' %>>Paid</option>
        <option value="Pending" <%= filters.paymentStatus === 'Pending' ? 'selected' : '' %>>Pending</option>
        <option value="Overdue" <%= filters.paymentStatus === 'Overdue' ? 'selected' : '' %>>Overdue</option>
      </select>
    </div>

    <div class="col-6 col-md-2">
      <select name="timeframe" class="form-select form-select-sm">
        <option value="all" <%= filters.timeframe === 'all' ? 'selected' : '' %>>All Time</option>
        <option value="month" <%= filters.timeframe === 'month' ? 'selected' : '' %>>This Month</option>
        <option value="week" <%= filters.timeframe === 'week' ? 'selected' : '' %>>This Week</option>
        <option value="today" <%= filters.timeframe === 'today' ? 'selected' : '' %>>Today</option>
      </select>
    </div>

    <div class="col-6 col-md-2">
      <select name="recurring" class="form-select form-select-sm">
        <option value="">All Types</option>
        <option value="true" <%= filters.recurring === 'true' ? 'selected' : '' %>>Recurring Only</option>
        <option value="false" <%= filters.recurring === 'false' ? 'selected' : '' %>>One-time Only</option>
      </select>
    </div>

    <div class="col-12 col-md-1 d-flex gap-1">
      <button type="submit" class="btn btn-sm btn-dark w-100" title="Apply Filters">Filter</button>
      <% if (filters.search || filters.category || filters.paymentStatus || (filters.timeframe && filters.timeframe !== 'all') || filters.recurring) { %>
        <a href="/expenses" class="btn btn-sm btn-outline-secondary" title="Reset Filters"><i class="bi bi-x-lg"></i></a>
      <% } %>
    </div>
  </form>
</div>

<!-- Expenses Ledger Table -->
<div class="card-business p-0 overflow-hidden">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th class="ps-3">Expense Details</th>
          <th>Category</th>
          <th>Date &amp; Due</th>
          <th>Type</th>
          <th class="text-end">Amount</th>
          <th class="text-center">Status</th>
          <th class="text-end pe-3">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (expenses && expenses.length > 0) { %>
          <% expenses.forEach(exp => { %>
            <tr>
              <td class="ps-3">
                <div class="fw-semibold text-dark"><%= exp.title %></div>
                <% if (exp.notes) { %>
                  <div class="text-muted text-xs text-truncate" style="max-width: 250px;"><%= exp.notes %></div>
                <% } %>
              </td>

              <td>
                <% 
                  let icon = 'bi-tag-fill';
                  let catColor = 'bg-secondary-subtle text-secondary';
                  if (exp.category === 'Rent') { icon = 'bi-building'; catColor = 'bg-danger-subtle text-danger'; }
                  else if (exp.category === 'Salary') { icon = 'bi-person-badge-fill'; catColor = 'bg-primary-subtle text-primary'; }
                  else if (exp.category === 'Electricity') { icon = 'bi-lightning-charge-fill'; catColor = 'bg-warning-subtle text-warning-emphasis'; }
                  else if (exp.category === 'Transport') { icon = 'bi-truck'; catColor = 'bg-info-subtle text-info-emphasis'; }
                  else if (exp.category === 'Internet') { icon = 'bi-wifi'; catColor = 'bg-primary-subtle text-primary'; }
                  else if (exp.category === 'Packaging') { icon = 'bi-box-seam-fill'; catColor = 'bg-success-subtle text-success'; }
                  else if (exp.category === 'Maintenance' || exp.category === 'Repairs') { icon = 'bi-tools'; catColor = 'bg-warning-subtle text-warning-emphasis'; }
                  else if (exp.category === 'Marketing') { icon = 'bi-megaphone-fill'; catColor = 'bg-info-subtle text-info'; }
                  else if (exp.category === 'Taxes') { icon = 'bi-cash-coin'; catColor = 'bg-dark-subtle text-dark'; }
                %>
                <span class="badge <%= catColor %> d-inline-flex align-items-center gap-1">
                  <i class="bi <%= icon %>"></i>
                  <span><%= exp.category %></span>
                </span>
              </td>

              <td>
                <div class="text-xs fw-medium text-dark"><%= new Date(exp.date).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %></div>
                <% if (exp.dueDate) { %>
                  <div class="text-xs <%= exp.paymentStatus === 'Overdue' ? 'text-danger fw-semibold' : 'text-muted' %>">
                    Due: <%= new Date(exp.dueDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short' }) %>
                  </div>
                <% } %>
              </td>

              <td>
                <% if (exp.recurring) { %>
                  <span class="badge bg-primary-subtle text-primary border border-primary-subtle text-xs">
                    <i class="bi bi-arrow-repeat me-1"></i>Recurring
                  </span>
                <% } else { %>
                  <span class="text-muted text-xs">One-time</span>
                <% } %>
              </td>

              <td class="text-end fw-bold text-dark">
                <%= currency %><%= exp.amount.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
              </td>

              <td class="text-center">
                <% if (exp.paymentStatus === 'Paid') { %>
                  <span class="badge bg-success-subtle text-success border border-success-subtle">
                    <i class="bi bi-check-circle-fill me-1"></i>Paid
                  </span>
                <% } else if (exp.paymentStatus === 'Overdue') { %>
                  <span class="badge bg-danger text-white">
                    <i class="bi bi-exclamation-octagon-fill me-1"></i>Overdue
                  </span>
                <% } else { %>
                  <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                    <i class="bi bi-clock me-1"></i>Pending
                  </span>
                <% } %>
              </td>

              <td class="text-end pe-3">
                <div class="d-flex justify-content-end gap-1">
                  <% if (exp.paymentStatus !== 'Paid') { %>
                    <form action="/expenses/<%= exp._id %>/pay" method="POST" class="d-inline m-0">
                      <button type="submit" class="btn btn-xs btn-outline-success" title="Mark as Paid">
                        <i class="bi bi-check-lg"></i> Pay
                      </button>
                    </form>
                  <% } %>

                  <a href="/expenses/<%= exp._id %>/edit" class="btn btn-xs btn-outline-secondary" title="Edit Expense">
                    <i class="bi bi-pencil"></i>
                  </a>

                  <button 
                    type="button" 
                    class="btn btn-xs btn-outline-danger" 
                    data-bs-toggle="modal" 
                    data-bs-target="#deleteModal<%= exp._id %>" 
                    title="Delete Expense"
                  >
                    <i class="bi bi-trash"></i>
                  </button>
                </div>

                <!-- Delete Confirmation Modal -->
                <div class="modal fade" id="deleteModal<%= exp._id %>" tabindex="-1" aria-hidden="true">
                  <div class="modal-dialog modal-dialog-centered modal-sm">
                    <div class="modal-content">
                      <div class="modal-header py-2">
                        <h6 class="modal-title text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Delete Expense</h6>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                      </div>
                      <div class="modal-body text-start">
                        <p class="mb-2">Are you sure you want to delete this expense record?</p>
                        <div class="p-2 bg-light rounded text-xs">
                          <strong><%= exp.title %></strong><br>
                          <%= exp.category %> &bull; <%= currency %><%= exp.amount.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                        </div>
                      </div>
                      <div class="modal-footer py-1">
                        <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancel</button>
                        <form action="/expenses/<%= exp._id %>?_method=DELETE" method="POST" class="m-0">
                          <button type="submit" class="btn btn-sm btn-danger">Confirm Delete</button>
                        </form>
                      </div>
                    </div>
                  </div>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="7" class="text-center py-5 text-muted">
              <i class="bi bi-wallet2 fs-1 text-secondary opacity-50 mb-2 d-block"></i>
              <h6>No expense records found</h6>
              <p class="text-xs mb-3">Record non-inventory outflows, store rent, utility bills, and petty cash.</p>
              <a href="/expenses/new" class="btn btn-sm btn-primary">
                <i class="bi bi-plus-circle me-1"></i> Record First Expense
              </a>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
