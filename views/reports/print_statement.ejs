<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= reportTitle %> - <%= businessName %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      background-color: #f8fafc;
      color: #1e293b;
      margin: 0;
      padding: 24px;
    }
    .print-sheet {
      max-width: 900px;
      margin: 0 auto;
      background: #ffffff;
      padding: 40px;
      border-radius: 8px;
      box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
    }
    .company-header {
      border-bottom: 2px solid #e2e8f0;
      padding-bottom: 20px;
      margin-bottom: 24px;
    }
    .summary-box {
      background-color: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 6px;
      padding: 14px 18px;
      text-align: center;
    }
    .summary-box .label {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #64748b;
      margin-bottom: 4px;
    }
    .summary-box .value {
      font-size: 1.25rem;
      font-weight: 700;
      color: #0f172a;
    }
    .table th {
      background-color: #f1f5f9;
      color: #475569;
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .table td {
      font-size: 0.875rem;
      vertical-align: middle;
    }
    .signature-section {
      margin-top: 50px;
      padding-top: 20px;
      border-top: 1px dashed #cbd5e1;
    }
    @media print {
      body {
        background-color: #ffffff;
        padding: 0;
      }
      .no-print {
        display: none !important;
      }
      .print-sheet {
        box-shadow: none;
        padding: 0;
        max-width: 100%;
      }
    }
  </style>
</head>
<body>

  <!-- Screen Control Bar -->
  <div class="no-print d-flex justify-content-between align-items-center mb-4 max-w-900 mx-auto" style="max-width: 900px;">
    <button onclick="window.history.back()" class="btn btn-outline-secondary">
      <i class="bi bi-arrow-left"></i> Back to Dashboard
    </button>
    <div class="d-flex gap-2">
      <button onclick="window.print()" class="btn btn-primary">
        <i class="bi bi-printer-fill me-1"></i> Print / Save as PDF
      </button>
    </div>
  </div>

  <!-- Printable Sheet Canvas -->
  <div class="print-sheet">
    <div class="company-header d-flex justify-content-between align-items-start">
      <div>
        <h2 class="fw-bold mb-1 text-primary"><%= businessName %></h2>
        <div class="text-muted small">Smart Business Manager &bull; Operational Statement</div>
      </div>
      <div class="text-end">
        <h4 class="fw-bold text-dark mb-1"><%= reportTitle %></h4>
        <div class="text-muted small">Generated: <%= generatedAt %></div>
      </div>
    </div>

    <!-- Summary KPI Row -->
    <% if (summaryCards && summaryCards.length > 0) { %>
      <div class="row g-3 mb-4">
        <% summaryCards.forEach(card => { %>
          <div class="col">
            <div class="summary-box">
              <div class="label"><%= card.label %></div>
              <div class="value"><%= card.value %></div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>

    <!-- Statement Table -->
    <table class="table table-bordered mb-4">
      <thead>
        <tr>
          <% headers.forEach((h, idx) => { %>
            <th class="<%= idx === headers.length - 1 ? 'text-end' : '' %>"><%= h %></th>
          <% }); %>
        </tr>
      </thead>
      <tbody>
        <% if (dataItems.length === 0) { %>
          <tr>
            <td colspan="<%= headers.length %>" class="text-center py-4 text-muted">
              No entries recorded for this statement period.
            </td>
          </tr>
        <% } else { %>
          <% dataItems.forEach(item => { %>
            <tr>
              <td class="font-monospace"><%= item.col1 %></td>
              <td><%= item.col2 %></td>
              <td><%= item.col3 %></td>
              <td><%= item.col4 %></td>
              <td class="text-end fw-bold"><%= item.col5 %></td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>

    <!-- Verification / Signature Area -->
    <div class="signature-section d-flex justify-content-between text-muted small">
      <div>
        <strong>System Generated Document:</strong> Verified by Smart Business Manager audit engine.
      </div>
      <div class="text-end" style="min-width: 200px;">
        <div class="border-bottom border-dark mb-1" style="height: 40px;"></div>
        <div>Authorized Signatory</div>
      </div>
    </div>
  </div>

</body>
</html>
