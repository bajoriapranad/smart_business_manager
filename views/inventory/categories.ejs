<%- include('../partials/header') %>

<div class="page-header">
  <div>
    <h1 class="page-title">Product Categories</h1>
    <p class="page-subtitle">Organize your inventory catalog into structured business categories</p>
  </div>
  <div>
    <a href="/inventory" class="btn btn-sm btn-outline-secondary">
      <i class="bi bi-arrow-left me-1"></i> Back to Products
    </a>
  </div>
</div>

<div class="row g-4">
  <!-- Add New Category Form -->
  <div class="col-12 col-lg-4">
    <div class="card-business p-4">
      <h6 class="fw-bold text-dark mb-3">
        <i class="bi bi-folder-plus text-primary me-1"></i> Add Category
      </h6>
      <form action="/inventory/categories" method="POST">
        <div class="mb-3">
          <label for="name" class="form-label fw-semibold small text-secondary">Category Name <span class="text-danger">*</span></label>
          <input 
            type="text" 
            class="form-control" 
            id="name" 
            name="name" 
            placeholder="e.g. Snacks &amp; Confectionery" 
            required
          >
        </div>

        <div class="mb-3">
          <label for="description" class="form-label fw-semibold small text-secondary">Description</label>
          <textarea 
            class="form-control" 
            id="description" 
            name="description" 
            rows="3" 
            placeholder="Category scope and notes..."
          ></textarea>
        </div>

        <div class="d-grid">
          <button type="submit" class="btn btn-sm btn-primary">
            <i class="bi bi-check-circle me-1"></i> Create Category
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Categories List Table -->
  <div class="col-12 col-lg-8">
    <div class="card-business">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span class="fw-semibold">
          <i class="bi bi-tags me-1 text-secondary"></i> Existing Categories (<%= categories.length %>)
        </span>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-business table-hover mb-0">
            <thead>
              <tr>
                <th>Category Name</th>
                <th>Description</th>
                <th class="text-center">Assigned Products</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (categories && categories.length > 0) { %>
                <% categories.forEach(cat => { %>
                  <% const prodCount = countMap[cat._id.toString()] || 0; %>
                  <tr>
                    <td>
                      <span class="fw-semibold text-dark"><%= cat.name %></span>
                    </td>
                    <td class="text-muted"><%= cat.description || '—' %></td>
                    <td class="text-center">
                      <span class="badge bg-light text-dark border px-2 py-1">
                        <%= prodCount %> <%= prodCount === 1 ? 'item' : 'items' %>
                      </span>
                    </td>
                    <td class="text-end">
                      <div class="btn-group btn-group-sm">
                        <!-- Edit Button triggering modal -->
                        <button 
                          type="button" 
                          class="btn btn-light border py-0 px-2" 
                          data-bs-toggle="modal" 
                          data-bs-target="#editModal<%= cat._id %>"
                          title="Edit Category"
                        >
                          <i class="bi bi-pencil"></i>
                        </button>

                        <!-- Delete Form -->
                        <form action="/inventory/categories/<%= cat._id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete category &quot;<%= cat.name %>&quot;?');">
                          <button 
                            type="submit" 
                            class="btn btn-light border py-0 px-2 text-danger <%= prodCount > 0 ? 'disabled' : '' %>" 
                            title="<%= prodCount > 0 ? 'Cannot delete category with assigned products' : 'Delete Category' %>"
                            <%= prodCount > 0 ? 'disabled' : '' %>
                          >
                            <i class="bi bi-trash"></i>
                          </button>
                        </form>
                      </div>

                      <!-- Edit Category Modal -->
                      <div class="modal fade text-start" id="editModal<%= cat._id %>" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                          <div class="modal-content border">
                            <form action="/inventory/categories/<%= cat._id %>/edit" method="POST">
                              <div class="modal-header">
                                <h6 class="modal-title fw-bold">Edit Category</h6>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                              </div>
                              <div class="modal-body">
                                <div class="mb-3">
                                  <label class="form-label small fw-semibold">Category Name <span class="text-danger">*</span></label>
                                  <input type="text" name="name" class="form-control" value="<%= cat.name %>" required>
                                </div>
                                <div class="mb-3">
                                  <label class="form-label small fw-semibold">Description</label>
                                  <textarea name="description" class="form-control" rows="2"><%= cat.description || '' %></textarea>
                                </div>
                              </div>
                              <div class="modal-footer">
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-sm btn-primary">Save Changes</button>
                              </div>
                            </form>
                          </div>
                        </div>
                      </div>

                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="4" class="text-center py-4 text-muted">
                    No categories registered yet. Create your first category using the form on the left.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
