<%- include('./partials/header') %>

<div class="row justify-content-center py-5">
  <div class="col-12 col-md-6 text-center">
    <div class="card-business p-4">
      <div class="mb-3">
        <i class="bi bi-exclamation-triangle-fill text-warning" style="font-size: 3rem;"></i>
      </div>
      <h2 class="fw-bold mb-2">Error <%= statusCode || 500 %></h2>
      <p class="text-muted mb-4"><%= message || 'Something went wrong.' %></p>
      <div>
        <a href="/dashboard" class="btn btn-primary btn-sm px-4">
          <i class="bi bi-house-door me-1"></i> Return to Dashboard
        </a>
      </div>
    </div>
  </div>
</div>

<%- include('./partials/footer') %>
