<%- include('../partials/header') %>

<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
  <div>
    <div class="d-flex align-items-center gap-2 mb-1">
      <a href="/reports" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i> Hub</a>
      <h1 class="page-title mb-0">Sales Register Report</h1>
    </div>
    <p class="page-subtitle mb-0">Comprehensive transaction registry with revenue, margin, and payment reconciliation</p>
  </div>
  <div class="d-flex align-items-center gap-2">
    <a href="/reports/sales?format=csv&timeframe=<%= timeframe %>&startDate=<%= startDate %>&endDate=<%= endDate %>" class="btn btn-success">
      <i class="bi bi-file-earmark-excel me-1"></i> Download CSV
    </a>
    <a href="/reports/print?type=sales&timeframe=<%= timeframe %>&startDate=<%= startDate %>&endDate=<%= endDate %>" target="_blank" class="btn btn-outline-secondary">
      <i class="bi bi-printer me-1"></i> Print Statement
    </a>
  </div>
</div>

<!-- Timeframe Filter Toolbar -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
  <div class="card-body p-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
      <div class="btn-group btn-group-sm" role="group">
        <a href="/reports/sales?timeframe=7days" class="btn <%= timeframe === '7days' ? 'btn-primary' : 'btn-outline-secondary' %>">Last 7 Days</a>
        <a href="/reports/sales?timeframe=30days" class="btn <%= timeframe === '30days' ? 'btn-primary' : 'btn-outline-secondary' %>">Last 30 Days</a>
        <a href="/reports/sales?timeframe=this_month" class="btn <%= timeframe === 'this_month' ? 'btn-primary' : 'btn-outline-secondary' %>">This Month</a>
        <a href="/reports/sales?timeframe=last_month" class="btn <%= timeframe === 'last_month' ? 'btn-primary' : 'btn-outline-secondary' %>">Last Month</a>
        <a href="/reports/sales?timeframe=this_year" class="btn <%= timeframe === 'this_year' ? 'btn-primary' : 'btn-outline-secondary' %>">This Year</a>
        <a href="/reports/sales?timeframe=all" class="btn <%= timeframe === 'all' ? 'btn-primary' : 'btn-outline-secondary' %>">All Time</a>
      </div>

      <form method="GET" action="/reports/sales" class="d-flex align-items-center gap-2">
        <input type="hidden" name="timeframe" value="custom">
        <input type="date" name="startDate" class="form-control form-control-sm" value="<%= startDate %>" required>
        <span class="text-muted small">to</span>
        <input type="date" name="endDate" class="form-control form-control-sm" value="<%= endDate %>" required>
        <button type="submit" class="btn btn-sm btn-primary">Filter</button>
      </form>
    </div>
  </div>
</div>

<!-- Summary Metrics -->
<div class="row g-3 mb-4">
  <div class="col-6 col-md-3">
    <div class="stat-card">
      <span class="stat-label">Total Revenue</span>
      <div class="stat-value text-dark">
        <%= currency %><%= totals.revenue.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
      </div>
      <div class="stat-subtext text-muted"><%= sales.length %> orders</div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="stat-card">
      <span class="stat-label">Total COGS</span>
      <div class="stat-value text-secondary">
        <%= currency %><%= totals.cogs.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
      </div>
      <div class="stat-subtext text-muted">Procurement cost</div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="stat-card">
      <span class="stat-label">Gross Profit</span>
      <div class="stat-value <%= totals.profit >= 0 ? 'text-success' : 'text-danger' %>">
        <%= currency %><%= totals.profit.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
      </div>
      <div class="stat-subtext">
        <span class="badge bg-success-subtle text-success"><%= totals.margin %>% Margin</span>
      </div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="stat-card">
      <span class="stat-label">Discounts Conceded</span>
      <div class="stat-value text-warning">
        <%= currency %><%= totals.discount.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
      </div>
      <div class="stat-subtext text-muted">Customer discounts</div>
    </div>
  </div>
</div>

<!-- Sales Table -->
<div class="card border-0 shadow-sm rounded-3">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="ps-4">Invoice #</th>
            <th>Date</th>
            <th>Customer</th>
            <th class="text-center">Items</th>
            <th class="text-end">Total</th>
            <th class="text-end">COGS</th>
            <th class="text-end">Gross Profit</th>
            <th class="text-center">Method</th>
            <th class="text-center pe-4">Status</th>
          </tr>
        </thead>
        <tbody>
          <% if (sales.length === 0) { %>
            <tr>
              <td colspan="9" class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                No sales records found for this timeframe.
              </td>
            </tr>
          <% } else { %>
            <% sales.forEach(s => { %>
              <tr>
                <td class="ps-4 fw-bold">
                  <a href="/sales/<%= s._id %>" class="text-decoration-none text-primary">
                    <%= s.invoiceNumber %>
                  </a>
                </td>
                <td class="text-muted small">
                  <%= new Date(s.saleDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                </td>
                <td>
                  <div class="fw-semibold"><%= s.customerName %></div>
                  <% if (s.customerPhone) { %>
                    <div class="text-muted small"><%= s.customerPhone %></div>
                  <% } %>
                </td>
                <td class="text-center">
                  <span class="badge bg-light text-dark"><%= s.items ? s.items.length : 0 %></span>
                </td>
                <td class="text-end fw-bold">
                  <%= currency %><%= s.finalAmount.toFixed(2) %>
                  <% if (s.discountAmount > 0) { %>
                    <div class="text-danger small">-<%= currency %><%= s.discountAmount.toFixed(2) %></div>
                  <% } %>
                </td>
                <td class="text-end text-muted">
                  <%= currency %><%= s.costOfGoodsSold.toFixed(2) %>
                </td>
                <td class="text-end fw-semibold <%= s.grossProfit >= 0 ? 'text-success' : 'text-danger' %>">
                  <%= currency %><%= s.grossProfit.toFixed(2) %>
                </td>
                <td class="text-center">
                  <span class="badge bg-secondary-subtle text-secondary"><%= s.paymentMethod %></span>
                </td>
                <td class="text-center pe-4">
                  <% if (s.paymentStatus === 'Paid') { %>
                    <span class="badge bg-success-subtle text-success">Paid</span>
                  <% } else if (s.paymentStatus === 'Partial') { %>
                    <span class="badge bg-warning-subtle text-warning">Partial</span>
                  <% } else { %>
                    <span class="badge bg-danger-subtle text-danger">Unpaid</span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
