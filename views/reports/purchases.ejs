<%- include('../partials/header') %>

<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
  <div>
    <div class="d-flex align-items-center gap-2 mb-1">
      <a href="/reports" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i> Hub</a>
      <h1 class="page-title mb-0">Supplier Purchases &amp; Payables Report</h1>
    </div>
    <p class="page-subtitle mb-0">Procurement register, supplier dues, and replenishment cash flow tracking</p>
  </div>
  <div class="d-flex align-items-center gap-2">
    <a href="/reports/purchases?format=csv&timeframe=<%= timeframe %>&startDate=<%= startDate %>&endDate=<%= endDate %>" class="btn btn-success">
      <i class="bi bi-file-earmark-excel me-1"></i> Download CSV
    </a>
  </div>
</div>

<!-- Timeframe Filter Toolbar -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
  <div class="card-body p-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
      <div class="btn-group btn-group-sm" role="group">
        <a href="/reports/purchases?timeframe=7days" class="btn <%= timeframe === '7days' ? 'btn-primary' : 'btn-outline-secondary' %>">Last 7 Days</a>
        <a href="/reports/purchases?timeframe=30days" class="btn <%= timeframe === '30days' ? 'btn-primary' : 'btn-outline-secondary' %>">Last 30 Days</a>
        <a href="/reports/purchases?timeframe=this_month" class="btn <%= timeframe === 'this_month' ? 'btn-primary' : 'btn-outline-secondary' %>">This Month</a>
        <a href="/reports/purchases?timeframe=last_month" class="btn <%= timeframe === 'last_month' ? 'btn-primary' : 'btn-outline-secondary' %>">Last Month</a>
        <a href="/reports/purchases?timeframe=this_year" class="btn <%= timeframe === 'this_year' ? 'btn-primary' : 'btn-outline-secondary' %>">This Year</a>
        <a href="/reports/purchases?timeframe=all" class="btn <%= timeframe === 'all' ? 'btn-primary' : 'btn-outline-secondary' %>">All Time</a>
      </div>

      <form method="GET" action="/reports/purchases" class="d-flex align-items-center gap-2">
        <input type="hidden" name="timeframe" value="custom">
        <input type="date" name="startDate" class="form-control form-control-sm" value="<%= startDate %>" required>
        <span class="text-muted small">to</span>
        <input type="date" name="endDate" class="form-control form-control-sm" value="<%= endDate %>" required>
        <button type="submit" class="btn btn-sm btn-primary">Filter</button>
      </form>
    </div>
  </div>
</div>

<!-- Summary Metrics -->
<div class="row g-3 mb-4">
  <div class="col-6 col-md-4">
    <div class="stat-card">
      <span class="stat-label">Total Procurement</span>
      <div class="stat-value text-dark">
        <%= currency %><%= totals.totalPurchases.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
      </div>
      <div class="stat-subtext text-muted"><%= purchases.length %> purchase orders</div>
    </div>
  </div>
  <div class="col-6 col-md-4">
    <div class="stat-card">
      <span class="stat-label">Disbursed (Settled)</span>
      <div class="stat-value text-success">
        <%= currency %><%= totals.totalPaid.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
      </div>
      <div class="stat-subtext text-muted">Paid to suppliers</div>
    </div>
  </div>
  <div class="col-12 col-md-4">
    <div class="stat-card border-start border-4 <%= totals.totalDue > 0 ? 'border-danger' : 'border-success' %>">
      <span class="stat-label">Outstanding Payables</span>
      <div class="stat-value <%= totals.totalDue > 0 ? 'text-danger' : 'text-success' %>">
        <%= currency %><%= totals.totalDue.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
      </div>
      <div class="stat-subtext text-muted">Remaining creditor liability</div>
    </div>
  </div>
</div>

<!-- Purchases Table -->
<div class="card border-0 shadow-sm rounded-3">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="ps-4">Invoice #</th>
            <th>Date</th>
            <th>Supplier</th>
            <th class="text-center">Items</th>
            <th class="text-end">Total Amount</th>
            <th class="text-end">Paid Amount</th>
            <th class="text-end">Balance Due</th>
            <th class="text-center pe-4">Status</th>
          </tr>
        </thead>
        <tbody>
          <% if (purchases.length === 0) { %>
            <tr>
              <td colspan="8" class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                No purchase records found for this timeframe.
              </td>
            </tr>
          <% } else { %>
            <% purchases.forEach(p => { %>
              <tr>
                <td class="ps-4 fw-bold">
                  <a href="/purchases/<%= p._id %>" class="text-decoration-none text-primary">
                    <%= p.invoiceNumber %>
                  </a>
                </td>
                <td class="text-muted small">
                  <%= new Date(p.purchaseDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                </td>
                <td>
                  <div class="fw-semibold"><%= p.supplier ? p.supplier.name : 'Unknown Supplier' %></div>
                  <% if (p.supplier && p.supplier.phone) { %>
                    <div class="text-muted small"><%= p.supplier.phone %></div>
                  <% } %>
                </td>
                <td class="text-center">
                  <span class="badge bg-light text-dark"><%= p.items ? p.items.length : 0 %></span>
                </td>
                <td class="text-end fw-bold text-dark">
                  <%= currency %><%= p.totalAmount.toFixed(2) %>
                </td>
                <td class="text-end text-success">
                  <%= currency %><%= p.paidAmount.toFixed(2) %>
                </td>
                <td class="text-end fw-semibold <%= p.remainingAmount > 0 ? 'text-danger' : 'text-muted' %>">
                  <%= currency %><%= p.remainingAmount.toFixed(2) %>
                </td>
                <td class="text-center pe-4">
                  <% if (p.paymentStatus === 'Paid') { %>
                    <span class="badge bg-success-subtle text-success">Paid</span>
                  <% } else if (p.paymentStatus === 'Partial') { %>
                    <span class="badge bg-warning-subtle text-warning">Partial</span>
                  <% } else { %>
                    <span class="badge bg-danger-subtle text-danger">Unpaid</span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
