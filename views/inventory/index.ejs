<%- include('../partials/header') %>

<div class="page-header">
  <div>
    <h1 class="page-title">Inventory &amp; Products</h1>
    <p class="page-subtitle">Manage store catalog, stock levels, valuations, and replenishment</p>
  </div>
  <div class="d-flex align-items-center gap-2">
    <a href="/inventory/categories" class="btn btn-sm btn-outline-secondary">
      <i class="bi bi-tags me-1"></i> Categories
    </a>
    <a href="/inventory/new" class="btn btn-sm btn-primary">
      <i class="bi bi-plus-circle me-1"></i> Add Product
    </a>
  </div>
</div>

<!-- Stock Valuation Summary Cards -->
<div class="row g-3 mb-4">
  <div class="col-6 col-md-3">
    <div class="stat-card">
      <span class="stat-label">Total Catalog SKUs</span>
      <div class="stat-value text-dark"><%= summary.totalProducts %></div>
      <div class="stat-subtext text-muted"><%= summary.totalUnits %> total physical units</div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="stat-card">
      <span class="stat-label">Total Stock Value</span>
      <div class="stat-value text-primary"><%= currency %><%= summary.totalStockValue.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div>
      <div class="stat-subtext text-muted">At purchase cost</div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="stat-card">
      <span class="stat-label">Potential Revenue</span>
      <div class="stat-value text-success"><%= currency %><%= summary.totalPotentialRevenue.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div>
      <div class="stat-subtext text-muted">At retail selling price</div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="stat-card">
      <span class="stat-label">Potential Profit</span>
      <div class="stat-value text-dark">
        <%= currency %><%= (summary.totalPotentialRevenue - summary.totalStockValue).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
      </div>
      <div class="stat-subtext text-muted">
        Margin: <%= summary.totalPotentialRevenue > 0 ? (((summary.totalPotentialRevenue - summary.totalStockValue) / summary.totalPotentialRevenue) * 100).toFixed(1) : 0 %>%
      </div>
    </div>
  </div>
</div>

<!-- Search, Filters & Sorting Toolbar -->
<div class="card-business mb-3 p-3">
  <form action="/inventory" method="GET" class="row g-2 align-items-center">
    <!-- Search Bar -->
    <div class="col-12 col-md-4">
      <div class="input-group input-group-sm">
        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
        <input 
          type="text" 
          name="search" 
          class="form-control border-start-0 ps-0" 
          placeholder="Search by name, SKU, or brand..." 
          value="<%= filters.search || '' %>"
        >
      </div>
    </div>

    <!-- Category Filter -->
    <div class="col-6 col-md-3">
      <select name="category" class="form-select form-select-sm" onchange="this.form.submit()">
        <option value="">All Categories</option>
        <% categories.forEach(cat => { %>
          <option value="<%= cat._id %>" <%= filters.category == cat._id.toString() ? 'selected' : '' %>><%= cat.name %></option>
        <% }); %>
      </select>
    </div>

    <!-- Stock Status Filter -->
    <div class="col-6 col-md-2">
      <select name="stockStatus" class="form-select form-select-sm" onchange="this.form.submit()">
        <option value="">All Stock Levels</option>
        <option value="in_stock" <%= filters.stockStatus === 'in_stock' ? 'selected' : '' %>>Healthy Stock</option>
        <option value="low_stock" <%= filters.stockStatus === 'low_stock' ? 'selected' : '' %>>Low Stock</option>
        <option value="out_of_stock" <%= filters.stockStatus === 'out_of_stock' ? 'selected' : '' %>>Out of Stock</option>
      </select>
    </div>

    <!-- Sort By -->
    <div class="col-8 col-md-2">
      <select name="sort" class="form-select form-select-sm" onchange="this.form.submit()">
        <option value="createdAt_desc" <%= filters.sort === 'createdAt_desc' ? 'selected' : '' %>>Newest First</option>
        <option value="name_asc" <%= filters.sort === 'name_asc' ? 'selected' : '' %>>Name (A - Z)</option>
        <option value="name_desc" <%= filters.sort === 'name_desc' ? 'selected' : '' %>>Name (Z - A)</option>
        <option value="stock_asc" <%= filters.sort === 'stock_asc' ? 'selected' : '' %>>Stock (Low to High)</option>
        <option value="stock_desc" <%= filters.sort === 'stock_desc' ? 'selected' : '' %>>Stock (High to Low)</option>
        <option value="price_desc" <%= filters.sort === 'price_desc' ? 'selected' : '' %>>Price (High to Low)</option>
      </select>
    </div>

    <!-- Submit / Clear -->
    <div class="col-4 col-md-1 d-flex gap-1">
      <button type="submit" class="btn btn-sm btn-secondary w-100" title="Apply filters">
        <i class="bi bi-funnel"></i>
      </button>
      <% if (filters.search || filters.category || filters.stockStatus || (filters.sort && filters.sort !== 'createdAt_desc')) { %>
        <a href="/inventory" class="btn btn-sm btn-outline-danger" title="Clear filters">
          <i class="bi bi-x-lg"></i>
        </a>
      <% } %>
    </div>
  </form>
</div>

<!-- Products Table -->
<div class="card-business">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-business table-hover mb-0">
        <thead>
          <tr>
            <th>SKU</th>
            <th>Product Name &amp; Brand</th>
            <th>Category</th>
            <th>Current Stock</th>
            <th>Purchase Cost</th>
            <th>Selling Price</th>
            <th>Stock Value</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (products && products.length > 0) { %>
            <% products.forEach(prod => { %>
              <% 
                const stockVal = prod.currentStock * prod.purchasePrice; 
                let statusBadge = 'status-normal';
                let statusLabel = 'In Stock';
                if (prod.currentStock === 0) {
                  statusBadge = 'status-overdue';
                  statusLabel = 'Out of Stock';
                } else if (prod.currentStock <= prod.minimumStock) {
                  statusBadge = 'status-low';
                  statusLabel = 'Low Stock';
                }
              %>
              <tr>
                <td class="text-muted fw-mono" style="font-size: 12px;"><%= prod.sku %></td>
                <td>
                  <a href="/inventory/<%= prod._id %>" class="fw-semibold text-dark text-decoration-none hover-primary">
                    <%= prod.name %>
                  </a>
                  <% if (prod.brand) { %>
                    <small class="text-muted d-block" style="font-size: 11px;"><%= prod.brand %></small>
                  <% } %>
                </td>
                <td class="text-muted"><%= prod.category?.name || 'Unassigned' %></td>
                <td>
                  <span class="fw-bold <%= prod.currentStock === 0 ? 'text-danger' : (prod.currentStock <= prod.minimumStock ? 'text-warning' : 'text-dark') %>">
                    <%= prod.currentStock %>
                  </span>
                  <span class="text-muted small"><%= prod.unit %></span>
                </td>
                <td class="text-muted"><%= currency %><%= prod.purchasePrice.toFixed(2) %></td>
                <td class="fw-medium text-dark"><%= currency %><%= prod.sellingPrice.toFixed(2) %></td>
                <td class="text-dark"><%= currency %><%= stockVal.toFixed(2) %></td>
                <td>
                  <span class="badge-status <%= statusBadge %>"><%= statusLabel %></span>
                </td>
                <td class="text-end">
                  <div class="btn-group btn-group-sm">
                    <a href="/inventory/<%= prod._id %>" class="btn btn-light border py-0 px-2" title="View Details">
                      <i class="bi bi-eye"></i>
                    </a>
                    <a href="/inventory/<%= prod._id %>/edit" class="btn btn-light border py-0 px-2" title="Edit Product">
                      <i class="bi bi-pencil"></i>
                    </a>
                    <form action="/inventory/<%= prod._id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete product &quot;<%= prod.name %>&quot;?');">
                      <button type="submit" class="btn btn-light border py-0 px-2 text-danger" title="Delete Product">
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="9" class="text-center py-4 text-muted">
                <i class="bi bi-box-seam fs-3 d-block mb-2 text-secondary"></i>
                No products match the selected criteria.
                <div class="mt-2">
                  <a href="/inventory/new" class="btn btn-sm btn-primary">
                    <i class="bi bi-plus-circle me-1"></i> Add New Product
                  </a>
                </div>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Pagination Controls -->
  <% if (pagination.totalPages > 1) { %>
    <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center py-2 px-3">
      <small class="text-muted">
        Showing <%= ((pagination.page - 1) * pagination.limit) + 1 %> - <%= Math.min(pagination.page * pagination.limit, pagination.totalCount) %> of <%= pagination.totalCount %> products
      </small>
      <nav aria-label="Page navigation">
        <ul class="pagination pagination-sm mb-0">
          <li class="page-item <%= pagination.page <= 1 ? 'disabled' : '' %>">
            <a class="page-link" href="?page=<%= pagination.page - 1 %>&search=<%= filters.search %>&category=<%= filters.category %>&stockStatus=<%= filters.stockStatus %>&sort=<%= filters.sort %>">Previous</a>
          </li>
          <% for (let i = 1; i <= pagination.totalPages; i++) { %>
            <li class="page-item <%= pagination.page === i ? 'active' : '' %>">
              <a class="page-link" href="?page=<%= i %>&search=<%= filters.search %>&category=<%= filters.category %>&stockStatus=<%= filters.stockStatus %>&sort=<%= filters.sort %>"><%= i %></a>
            </li>
          <% } %>
          <li class="page-item <%= pagination.page >= pagination.totalPages ? 'disabled' : '' %>">
            <a class="page-link" href="?page=<%= pagination.page + 1 %>&search=<%= filters.search %>&category=<%= filters.category %>&stockStatus=<%= filters.stockStatus %>&sort=<%= filters.sort %>">Next</a>
          </li>
        </ul>
      </nav>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
