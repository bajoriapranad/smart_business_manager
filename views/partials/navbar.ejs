<nav class="app-navbar">
  <div class="navbar-left">
    <button class="btn btn-sm btn-outline-secondary d-lg-none" id="sidebarToggle" type="button" aria-label="Toggle navigation">
      <i class="bi bi-list"></i>
    </button>
    <div class="d-flex align-items-center gap-2">
      <span class="fw-bold text-dark d-none d-sm-inline"><%= typeof currentBusinessName !== 'undefined' && currentBusinessName ? currentBusinessName : 'Smart Business Manager' %></span>
      <% if (typeof isDemoUser !== 'undefined' && isDemoUser) { %>
        <span class="demo-mode-badge"><i class="bi bi-eye-fill me-1"></i>DEMO MODE</span>
      <% } %>
    </div>
  </div>

  <div class="navbar-right">
    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
      <div class="dropdown">
        <button class="btn btn-sm btn-light border dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
          <i class="bi bi-person-circle text-secondary"></i>
          <span class="d-none d-md-inline fw-medium"><%= currentUser.name %></span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow-sm border">
          <li><h6 class="dropdown-header text-truncate" style="max-width: 200px;"><%= currentUser.email %></h6></li>
          <li><a class="dropdown-item" href="/settings"><i class="bi bi-gear me-2"></i>Business Settings</a></li>
          <li><hr class="dropdown-divider"></li>
          <li>
            <form action="/auth/logout" method="POST" class="m-0">
              <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Logout</button>
            </form>
          </li>
        </ul>
      </div>
    <% } else { %>
      <a href="/auth/login" class="btn btn-sm btn-outline-primary">Login</a>
      <a href="/auth/register" class="btn btn-sm btn-primary">Create Account</a>
    <% } %>
  </div>
</nav>
