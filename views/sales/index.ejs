<%- include('../partials/header') %>

<div class="page-header">
  <div>
    <h1 class="page-title">Sales &amp; Billing Ledger</h1>
    <p class="page-subtitle">Track sales transactions, monitor profit margins, review customer bills, and manage receivables</p>
  </div>
  <div class="d-flex gap-2">
    <a href="/sales/pos" class="btn btn-sm btn-primary">
      <i class="bi bi-calculator me-1"></i> Open POS Terminal
    </a>
  </div>
</div>

<!-- Sales Financial KPI Summary Cards -->
<div class="row g-3 mb-4">
  <div class="col-6 col-md-3">
    <div class="stat-card">
      <span class="stat-label">Total Revenue</span>
      <div class="stat-value text-primary"><%= currency %><%= summary.totalSales.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div>
      <div class="stat-subtext text-muted"><%= summary.totalCount %> sales recorded</div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="stat-card">
      <span class="stat-label">Gross Profit</span>
      <div class="stat-value text-success"><%= currency %><%= summary.totalProfit.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div>
      <div class="stat-subtext text-muted">Revenue minus COGS</div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="stat-card">
      <span class="stat-label">Profit Margin</span>
      <div class="stat-value text-dark"><%= summary.marginPercent %>%</div>
      <div class="stat-subtext text-muted">Average gross margin</div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="stat-card">
      <span class="stat-label">Credit Receivables</span>
      <div class="stat-value <%= summary.totalCreditDue > 0 ? 'text-danger' : 'text-dark' %>">
        <%= currency %><%= summary.totalCreditDue.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
      </div>
      <div class="stat-subtext <%= summary.totalCreditDue > 0 ? 'text-danger fw-medium' : 'text-muted' %>">
        <%= summary.totalCreditDue > 0 ? 'Uncollected customer dues' : 'All bills collected' %>
      </div>
    </div>
  </div>
</div>

<!-- Search & Filter Bar -->
<div class="card-business mb-3 p-3">
  <form action="/sales" method="GET" class="row g-2 align-items-center">
    <div class="col-12 col-md-3">
      <div class="input-group input-group-sm">
        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
        <input 
          type="text" 
          name="search" 
          class="form-control border-start-0 ps-0" 
          placeholder="Search invoice #, customer..." 
          value="<%= filters.search %>"
        >
      </div>
    </div>
    <div class="col-6 col-md-2">
      <select name="dateRange" class="form-select form-select-sm">
        <option value="">All Time</option>
        <option value="today" <%= filters.dateRange === 'today' ? 'selected' : '' %>>Today</option>
        <option value="week" <%= filters.dateRange === 'week' ? 'selected' : '' %>>This Week</option>
        <option value="month" <%= filters.dateRange === 'month' ? 'selected' : '' %>>This Month</option>
      </select>
    </div>
    <div class="col-6 col-md-2">
      <select name="paymentMethod" class="form-select form-select-sm">
        <option value="">All Payment Methods</option>
        <option value="Cash" <%= filters.paymentMethod === 'Cash' ? 'selected' : '' %>>Cash</option>
        <option value="UPI" <%= filters.paymentMethod === 'UPI' ? 'selected' : '' %>>UPI</option>
        <option value="Card" <%= filters.paymentMethod === 'Card' ? 'selected' : '' %>>Card</option>
        <option value="Credit" <%= filters.paymentMethod === 'Credit' ? 'selected' : '' %>>Credit (Udhar)</option>
      </select>
    </div>
    <div class="col-6 col-md-2">
      <select name="paymentStatus" class="form-select form-select-sm">
        <option value="">All Statuses</option>
        <option value="Paid" <%= filters.paymentStatus === 'Paid' ? 'selected' : '' %>>Paid</option>
        <option value="Partially Paid" <%= filters.paymentStatus === 'Partially Paid' ? 'selected' : '' %>>Partially Paid</option>
        <option value="Pending" <%= filters.paymentStatus === 'Pending' ? 'selected' : '' %>>Pending</option>
      </select>
    </div>
    <div class="col-6 col-md-1">
      <button type="submit" class="btn btn-sm btn-secondary w-100">Filter</button>
    </div>
    <% if (filters.search || filters.dateRange || filters.paymentMethod || filters.paymentStatus) { %>
      <div class="col-6 col-md-2">
        <a href="/sales" class="btn btn-sm btn-outline-danger w-100">
          <i class="bi bi-x-circle me-1"></i> Clear
        </a>
      </div>
    <% } %>
  </form>
</div>

<!-- Sales Invoices Table -->
<div class="card-business">
  <div class="card-body p-0">
    <% if (sales && sales.length > 0) { %>
      <div class="table-responsive">
        <table class="table table-business table-hover mb-0">
          <thead>
            <tr>
              <th>Invoice #</th>
              <th>Date &amp; Time</th>
              <th>Customer</th>
              <th>Items</th>
              <th>Total Bill</th>
              <th>Profit</th>
              <th>Method</th>
              <th>Status</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% sales.forEach(s => { 
              const margin = s.finalAmount > 0 ? ((s.grossProfit / s.finalAmount) * 100).toFixed(0) : 0;
            %>
              <tr>
                <td>
                  <a href="/sales/<%= s._id %>" class="text-primary fw-bold text-decoration-none">
                    <%= s.invoiceNumber %>
                  </a>
                </td>
                <td class="text-muted" style="font-size: 11px;">
                  <%= new Date(s.saleDate).toLocaleDateString('en-IN', { month: 'short', day: 'numeric', year: 'numeric' }) %><br>
                  <%= new Date(s.saleDate).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' }) %>
                </td>
                <td>
                  <% if (s.customer) { %>
                    <a href="/customers/<%= s.customer._id %>" class="text-dark fw-medium text-decoration-none hover-primary">
                      <%= s.customerName %>
                    </a>
                    <% if (s.customer.loyaltyLevel && s.customer.loyaltyLevel !== 'Standard') { %>
                      <span class="badge bg-warning text-dark border border-warning ms-1" style="font-size: 10px;">
                        <%= s.customer.loyaltyLevel %>
                      </span>
                    <% } %>
                  <% } else { %>
                    <span class="text-muted"><%= s.customerName %></span>
                  <% } %>
                  <% if (s.customerPhone) { %>
                    <div class="text-muted" style="font-size: 11px;"><%= s.customerPhone %></div>
                  <% } %>
                </td>
                <td>
                  <span class="badge bg-light text-dark border">
                    <%= s.items ? s.items.length : 0 %> <%= (s.items && s.items.length === 1) ? 'item' : 'items' %>
                  </span>
                </td>
                <td class="fw-bold text-dark">
                  <%= currency %><%= s.finalAmount.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                  <% if (s.discountAmount > 0) { %>
                    <small class="text-success d-block" style="font-size: 10px;">Saved <%= currency %><%= s.discountAmount.toFixed(0) %></small>
                  <% } %>
                </td>
                <td>
                  <span class="fw-semibold <%= s.grossProfit >= 0 ? 'text-success' : 'text-danger' %>">
                    <%= currency %><%= s.grossProfit.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                  </span>
                  <small class="text-muted d-block" style="font-size: 10px;">(<%= margin %>% margin)</small>
                </td>
                <td>
                  <span class="badge bg-light text-dark border"><%= s.paymentMethod %></span>
                </td>
                <td>
                  <% if (s.paymentStatus === 'Paid') { %>
                    <span class="badge-status status-paid">Paid</span>
                  <% } else if (s.paymentStatus === 'Partially Paid') { %>
                    <span class="badge-status status-warning">Partial</span>
                  <% } else { %>
                    <span class="badge-status status-pending">Due</span>
                  <% } %>
                </td>
                <td class="text-end">
                  <div class="btn-group btn-group-sm">
                    <a href="/sales/<%= s._id %>" class="btn btn-outline-secondary" title="View Receipt & Print">
                      <i class="bi bi-printer"></i>
                    </a>
                    <button 
                      type="button" 
                      class="btn btn-outline-danger" 
                      title="Void / Cancel Sale"
                      onclick="confirmDeleteSale('<%= s._id %>', '<%= s.invoiceNumber %>')"
                    >
                      <i class="bi bi-trash"></i>
                    </button>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="empty-state py-5 text-center">
        <i class="bi bi-receipt-cutoff fs-1 text-secondary mb-3 d-block"></i>
        <h5 class="fw-bold text-dark">No Sales Invoices Found</h5>
        <p class="text-muted small mb-4">
          <% if (filters.search || filters.dateRange || filters.paymentMethod || filters.paymentStatus) { %>
            No transactions match the selected filter criteria.
          <% } else { %>
            Launch the POS Billing Terminal to quickly scan products, apply customer discounts, and print bills.
          <% } %>
        </p>
        <a href="/sales/pos" class="btn btn-sm btn-primary">
          <i class="bi bi-calculator me-1"></i> Open POS Terminal
        </a>
      </div>
    <% } %>
  </div>
</div>

<!-- Modal for Void Sale Confirmation -->
<div class="modal fade" id="deleteSaleModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title fw-bold text-danger">
          <i class="bi bi-exclamation-triangle me-2"></i> Void Sales Invoice
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p class="text-muted mb-2">Are you sure you want to void invoice <strong id="deleteInvoiceName" class="text-dark"></strong>?</p>
        <div class="alert alert-warning py-2 small mb-0">
          <i class="bi bi-info-circle me-1"></i> Voiding this invoice will restore sold item quantities back to product inventory and reverse customer lifetime spend and credit balances.
        </div>
      </div>
      <div class="modal-footer border-0 pt-0">
        <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <form id="deleteSaleForm" method="POST" action="">
          <input type="hidden" name="_method" value="DELETE">
          <button type="submit" class="btn btn-sm btn-danger">Void Invoice &amp; Restock</button>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  function confirmDeleteSale(id, invoiceNumber) {
    const modal = new bootstrap.Modal(document.getElementById('deleteSaleModal'));
    document.getElementById('deleteInvoiceName').textContent = '#' + invoiceNumber;
    document.getElementById('deleteSaleForm').action = '/sales/' + id + '?_method=DELETE';
    modal.show();
  }
</script>

<%- include('../partials/footer') %>
